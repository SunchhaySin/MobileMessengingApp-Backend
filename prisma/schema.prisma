generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  username            String
  password            String
  createdAt           DateTime       @default(now())
  alertFrom           Alert[]        @relation("receiver")
  alertsTo            Alert[]        @relation("sender")
  conversationAsUser1 Conversation[] @relation("ConversationUser1")
  conversationAsUser2 Conversation[] @relation("ConversationUser2")
  friendOf            Friend[]       @relation("FriendOf")
  friends             Friend[]       @relation("UserFriends")
  messages            Message[]
  sentRequests        Request[]      @relation("RequestFrom")
  receivedRequests    Request[]      @relation("RequestTo")
}

model Request {
  id          String        @id @default(uuid())
  requesterID String
  userID      String
  status      RequestStatus @default(Sent)
  createdAt   DateTime      @default(now())
  requestFrom User          @relation("RequestFrom", fields: [requesterID], references: [id])
  requestTo   User          @relation("RequestTo", fields: [userID], references: [id])

  @@unique([requesterID, userID])
  @@index([userID])
  @@index([requesterID])
}

model Friend {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  friendId  String
  friend    User     @relation("FriendOf", fields: [friendId], references: [id])
  user      User     @relation("UserFriends", fields: [userId], references: [id])

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  conversationId String
  sentAt         DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([sentAt])
}

model Conversation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user1Id   String
  user2Id   String
  user1     User      @relation("ConversationUser1", fields: [user1Id], references: [id])
  user2     User      @relation("ConversationUser2", fields: [user2Id], references: [id])
  messages  Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Alert {
  id         String     @id @default(uuid())
  senderId   String
  receiverId String
  message    String
  createdAt  DateTime   @default(now())
  type       AlertTypes
  receiver   User       @relation("receiver", fields: [receiverId], references: [id])
  sender     User       @relation("sender", fields: [senderId], references: [id])
}

enum RequestStatus {
  Sent
  Received
  Accepted
  Rejected
}

enum AlertTypes {
  Send_Request
  Reject_Request
  Delecte_Request
  Accept_Request
  Sent_Message
  Open_Chat
}
